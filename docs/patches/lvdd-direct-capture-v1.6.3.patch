diff --git a/DIRECT_CAPTURE.md b/DIRECT_CAPTURE.md
new file mode 100644
index 0000000..8d0965a
--- /dev/null
+++ b/DIRECT_CAPTURE.md
@@ -0,0 +1,34 @@
+# Direct GPU capture experiment
+
+Base: Nonary v1.6.3 plus the existing custom 21 modes and Vulkan HDR patch.
+Candidate package: 1.6.3.3; build with MSVC/WDK and the existing trusted catalog
+certificate. No changes to device ACLs, broker protocol, monitor modes, HDR
+capabilities, or hardware cursor policy.
+
+The private `capture_protocol.h` contract is mirrored in Sunshine. One
+SYSTEM/broker-only IOCTL binds a WDF file to an exact adapter LUID / target ID.
+It pins unnamed NT handles until file cleanup. The capture client duplicates
+them from WUDFHost; ordinary unelevated applications cannot open the interface.
+
+On demand, the existing frame worker copies acquired IddCx surfaces into three
+shared D3D11 textures. They form an overwriteable newest-frame mailbox, not a
+three-frame presentation queue. GPU keyed mutexes protect pixel ownership;
+one nonblocking metadata mutex protects 128 bytes. No CPU pixel readback, encoder,
+capture polling thread, global object names, or extra permanent service is added.
+Protected surfaces are never exported. AcquireBuffer2 supplies source QPC and
+color space; unsupported/missing metadata falls back in Sunshine.
+
+Keep D3D COM resources on the frame worker. File/monitor cleanup pins only NT
+handles, not D3D device/context COM references. Consumer shutdown stops copying;
+the next source update releases the mailbox on that same worker. Mode changes
+close a generation and signal consumers rather than waiting on them.
+
+The driver already disables optional hardware cursors for topology safety.
+Windows therefore composes the cursor into source surfaces. Per-client cursor
+suppression needs the DXGI backend, not a new driver cursor worker.
+
+Validation: build the driver, run `test_libvirtualdisplay`, then test the actual
+signed package with the SYSTEM-only probe and the Sunshine pendulum comparison.
+Unit tests alone do not establish GPU/driver lifecycle correctness. Export the
+installed driver package before deployment. Roll back the candidate INF and
+select DXGI if live validation fails; never disable Windows signature enforcement.
diff --git a/src/driver/windows_driver/capture_export.h b/src/driver/windows_driver/capture_export.h
new file mode 100644
index 0000000..6df0751
--- /dev/null
+++ b/src/driver/windows_driver/capture_export.h
@@ -0,0 +1,156 @@
+/** @file capture_export.h
+ * @brief Nonblocking, on-demand export from the existing IddCx frame worker.
+ */
+#pragma once
+#include "capture_protocol.h"
+#include <d3d11.h>
+#include <dxgi1_2.h>
+#include <wrl/client.h>
+#include <atomic>
+#include <memory>
+#include <mutex>
+
+namespace lvdd_export {
+  using Microsoft::WRL::ComPtr;
+  /** @brief An export generation pinned by the client's WDF file object. */
+  struct epoch {
+    HANDLE mapping {}, lock {}, event {};
+    HANDLE handles[lvdd_capture::slots] {};
+    lvdd_capture::shared *data {};
+    unsigned next {};
+
+    ~epoch() {
+      if (data) UnmapViewOfFile(data);
+      for (auto h : handles) if (h) CloseHandle(h);
+      if (mapping) CloseHandle(mapping);
+      if (lock) CloseHandle(lock);
+      if (event) CloseHandle(event);
+    }
+    /** @brief Initialize on the frame worker, never in a mode/assign callback. */
+    bool init(ID3D11Device *device, const D3D11_TEXTURE2D_DESC &source,
+              const IDDCX_METADATA2 &meta, LUID adapter,
+              ComPtr<ID3D11Texture2D> (&textures)[lvdd_capture::slots],
+              ComPtr<IDXGIKeyedMutex> (&keyed)[lvdd_capture::slots]) {
+      mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(lvdd_capture::shared), nullptr);
+      lock = CreateMutexW(nullptr, FALSE, nullptr);
+      event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+      if (!mapping || !lock || !event) return false;
+      data = static_cast<lvdd_capture::shared *>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(*data)));
+      if (!data) return false;
+      new (data) lvdd_capture::shared {};
+      data->width = source.Width; data->height = source.Height;
+      data->format = source.Format; data->color_space = meta.SurfaceColorSpace;
+      data->sdr_white_nits = meta.SdrWhiteLevel;
+      data->adapter_low = adapter.LowPart; data->adapter_high = adapter.HighPart;
+      D3D11_TEXTURE2D_DESC desc = source;
+      desc.MipLevels = 1; desc.ArraySize = 1;
+      desc.Usage = D3D11_USAGE_DEFAULT; desc.CPUAccessFlags = 0;
+      desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+      desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+      for (unsigned i = 0; i < lvdd_capture::slots; ++i) {
+        ComPtr<IDXGIResource1> resource;
+        if (FAILED(device->CreateTexture2D(&desc, nullptr, &textures[i])) ||
+            FAILED(textures[i].As(&resource)) || FAILED(textures[i].As(&keyed[i])) ||
+            FAILED(resource->CreateSharedHandle(nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE, nullptr, &handles[i]))) return false;
+      }
+      return true;
+    }
+    /** @brief Wake the client to reinitialize/fall back; no waits in teardown. */
+    void close(LONG reason = 0) {
+      if (data) InterlockedExchange(reinterpret_cast<volatile LONG *>(&data->state), reason);
+      if (event) SetEvent(event);
+    }
+    /** @brief Build a reply without exposing any named global objects. */
+    lvdd_capture::reply describe() const {
+      lvdd_capture::reply r;
+      r.producer_pid = GetCurrentProcessId(); r.mapping_bytes = sizeof(lvdd_capture::shared);
+      r.mapping = reinterpret_cast<UINT_PTR>(mapping);
+      r.lock = reinterpret_cast<UINT_PTR>(lock); r.event = reinterpret_cast<UINT_PTR>(event);
+      for (unsigned i = 0; i < lvdd_capture::slots; ++i) r.textures[i] = reinterpret_cast<UINT_PTR>(handles[i]);
+      return r;
+    }
+  };
+  /** @brief Per-monitor connection point; holds NT handles, never a D3D device/context. */
+  struct hub {
+    std::atomic<unsigned> readers {0};
+    std::mutex mutex;
+    std::shared_ptr<epoch> current;
+  };
+  /** @brief Pin both handles and subscription until WDF file cleanup (including crashes). */
+  struct binding {
+    std::shared_ptr<hub> source;
+    std::shared_ptr<epoch> pinned;
+    std::uint32_t target {};
+    explicit binding(std::shared_ptr<hub> h, std::uint32_t id) : source(std::move(h)), target(id) { ++source->readers; }
+    ~binding() { --source->readers; }
+  };
+  /** @brief Frame-worker-local publisher; never waits for a consumer or exports protected content. */
+  class producer {
+    std::shared_ptr<hub> hub_;
+    std::shared_ptr<epoch> epoch_;
+    // COM resources must die on the frame worker, not during monitor/file cleanup.
+    ComPtr<ID3D11Texture2D> textures_[lvdd_capture::slots];
+    ComPtr<IDXGIKeyedMutex> keyed_[lvdd_capture::slots];
+    ComPtr<ID3D11DeviceContext> context_;
+    bool failed_ {};
+  public:
+    explicit producer(std::shared_ptr<hub> h) : hub_(std::move(h)) {}
+    ~producer() { if (epoch_) epoch_->close(); }
+    /** @brief Publish newest GPU frame, dropping work if a consumer holds the metadata lock. */
+    void publish(ID3D11Device *device, IDXGIResource *resource, const IDDCX_METADATA2 &meta, LUID adapter) {
+      if (!hub_ || failed_) return;
+      if (!hub_->readers.load(std::memory_order_relaxed)) {
+        if (epoch_) {
+          epoch_->close();
+          std::lock_guard guard(hub_->mutex);
+          if (hub_->current == epoch_) hub_->current.reset();
+          epoch_.reset();
+          for (auto &key : keyed_) key.Reset();
+          for (auto &texture : textures_) texture.Reset();
+          context_.Reset();
+        }
+        return;
+      }
+      ComPtr<ID3D11Texture2D> source;
+      D3D11_TEXTURE2D_DESC desc {};
+      if (meta.HwProtectedSurface || FAILED(resource->QueryInterface(IID_PPV_ARGS(&source)))) {
+        if (epoch_) epoch_->close(-1);
+        failed_ = true; return;
+      }
+      source->GetDesc(&desc);
+      if (!epoch_) {
+        auto candidate = std::make_shared<epoch>();
+        if (!candidate->init(device, desc, meta, adapter, textures_, keyed_)) { failed_ = true; return; }
+        device->GetImmediateContext(&context_);
+        epoch_ = std::move(candidate);
+        std::lock_guard guard(hub_->mutex);
+        if (hub_->current) hub_->current->close();
+        hub_->current = epoch_;
+      }
+      auto &e = *epoch_;
+      if (desc.Width != e.data->width || desc.Height != e.data->height ||
+          desc.Format != e.data->format || meta.SurfaceColorSpace != e.data->color_space) {
+        e.close(-1); failed_ = true; return;
+      }
+      const DWORD lock_result = WaitForSingleObject(e.lock, 0);
+      if (lock_result == WAIT_ABANDONED) { ReleaseMutex(e.lock); e.close(-1); failed_ = true; return; }
+      if (lock_result != WAIT_OBJECT_0) return;
+      for (unsigned n = 0; n < lvdd_capture::slots; ++n) {
+        const unsigned i = (e.next + n) % lvdd_capture::slots;
+        const HRESULT acquired = keyed_[i]->AcquireSync(0, 0);
+        if (acquired == WAIT_TIMEOUT) continue;
+        if (acquired != S_OK) { e.close(-1); failed_ = true; break; }
+        context_->CopyResource(textures_[i].Get(), source.Get());
+        context_->Flush();
+        const HRESULT released = keyed_[i]->ReleaseSync(0);
+        if (FAILED(released)) { e.close(-1); failed_ = true; break; }
+        LARGE_INTEGER now; QueryPerformanceCounter(&now);
+        e.data->frames[i] = {++e.data->produced, meta.PresentDisplayQPCTime, static_cast<std::uint64_t>(now.QuadPart)};
+        e.next = (i + 1) % lvdd_capture::slots;
+        ReleaseMutex(e.lock); SetEvent(e.event); return;
+      }
+      ++e.data->busy_drops;
+      ReleaseMutex(e.lock);
+    }
+  };
+}
